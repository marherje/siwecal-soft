# submit from a shell with init_siwecalsoft.sh sourced: $ENV(SIWECAL_SOFT_ROOT) is the checkout
universe                = vanilla
executable              = $ENV(SIWECAL_SOFT_ROOT)/data_conversion/jobs/condor/steer_validate.sh
arguments               = "$ENV(SIWECAL_SOFT_ROOT)/data_conversion/jobs/runs/run000166 run000166"
log                     = $ENV(SIWECAL_SOFT_ROOT)/data_conversion/jobs/runs/run000166/logs/pipeline.log
output                  = $ENV(SIWECAL_SOFT_ROOT)/data_conversion/jobs/runs/run000166/logs/pipeline.out
error                   = $ENV(SIWECAL_SOFT_ROOT)/data_conversion/jobs/runs/run000166/logs/pipeline.err
request_cpus            = 1
request_memory          = ifthenelse(NumJobStarts <= 0, 8000, 8000 * (NumJobStarts + 1))
request_disk            = 8000M
should_transfer_files   = NO
getenv                  = False
periodic_release        = (JobStatus == 5) && (HoldReasonCode == 34) && (NumJobStarts < 5)
+JobFlavour             = "workday"
queue
