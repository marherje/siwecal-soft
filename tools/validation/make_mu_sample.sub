# condor_submit tools/validation/make_mu_sample.sub   (from the repo root, init_siwecalsoft.sh sourced)
universe       = vanilla
executable     = /bin/bash
arguments      = $ENV(SIWECAL_SOFT_ROOT)/tools/validation/make_mu_sample.sh 2000
