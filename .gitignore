# build products
build/
install/
# local work: generated DAGs, condor logs, test samples (simulation/campaign/make_sim_dag.py writes work/condor_<campaign>)
work/
condor_*/
out_*/
# everything the HTCondor launchers generate, wherever they are run from:
#   DAGs and DAGMan's own files (.dag.condor.sub, .dagman.out/.log, .lib.out/.err, .nodes.log, .metrics, .lock, rescue DAGs),
#   submit files (the few versioned templates are already tracked; a new one needs `git add -f`),
#   steer/, log/ and macros/ of simulation/run/generic_condor_*.sh and launch_beam_final.sh,
#   generated/ of data_conversion/jobs/condor/generate_*_dag.py, test geometries of simulation/geometry/colltest/
*.dag
*.dag.*
*.rescue[0-9]*
*.sub
*.jdl
steer/
log/
macros/
generated/
simulation/geometry/colltest/
# environments and per-user settings
.venv/
settings.yml
config.yml
# data and outputs never live in the repo (EOS); figures are made, not versioned
*.root
*.slcio
*.npz
*.npy
*.pkl
*.png
*.pdf
*.log
*.out
*.err
logs/
core
core.*
# python / tools
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.ruff_cache/
# editors, personal tooling
.cache/
.idea/
.vscode/
.claude/
.mcp.json
/*.cc
