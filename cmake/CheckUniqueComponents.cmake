# siwecal_check_unique_components(): every DECLARE_COMPONENT / DECLARE_COMPONENT_WITH_ID name appears once in the
# C++ sources of the project; a duplicate fails the configure step with the files that declare it.
function(siwecal_check_unique_components)
  file(GLOB_RECURSE _srcs ${PROJECT_SOURCE_DIR}/*/src/*.cpp ${PROJECT_SOURCE_DIR}/*/*/src/*.cpp)
  set(_seen "")
  foreach(_f IN LISTS _srcs)
    file(STRINGS ${_f} _lines REGEX "^[ \t]*DECLARE_COMPONENT")
    foreach(_l IN LISTS _lines)
      if(_l MATCHES "DECLARE_COMPONENT_WITH_ID\\([^,]+,[ \t]*\"([^\"]+)\"")
        set(_name ${CMAKE_MATCH_1})
      elseif(_l MATCHES "DECLARE_COMPONENT\\([ \t]*([A-Za-z0-9_:]+)")
        set(_name ${CMAKE_MATCH_1})
      else()
        continue()
      endif()
      if(DEFINED _where_${_name})
        message(FATAL_ERROR "Gaudi component '${_name}' declared twice: ${_where_${_name}} and ${_f}")
      endif()
      set(_where_${_name} ${_f})
      list(APPEND _seen ${_name})
    endforeach()
  endforeach()
  list(LENGTH _seen _n)
  message(STATUS "Gaudi components: ${_n} unique names")
  set(SIWECAL_COMPONENTS ${_seen} PARENT_SCOPE)
endfunction()
